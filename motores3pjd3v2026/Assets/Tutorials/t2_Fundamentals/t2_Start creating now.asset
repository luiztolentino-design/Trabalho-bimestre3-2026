  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: '<b>1</b>.  Watch the video above.


      <b>2</b>.  In the <b>Project</b> window, open the folder <b>Assets</b> > <b>Skyboxes</b>.


      <b>3</b>.  Select any skybox to preview it in the <b>Inspector</b> window.


      <b>4</b>.  Drag any skybox material to the sky area in the scene.

'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &5581136774205932923
