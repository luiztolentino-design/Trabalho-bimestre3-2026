  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: "<b>1</b>.  In the top-left corner of the <b>Scene</b> view, select the <b>View</b> tool (hand) from the <b>Tool</b> overlay.\n\n<b>2</b>.  In the <b>Scene</b> view, left-click and drag with your mouse to pan your view from side to side. \n\nThis allows you to move around in 3D space.\n\n<b>3</b>.  Instead of clicking as you typically would, right-click and drag with your mouse or touchpad to look around. \n\nThis allows you to stay in one spot and rotate your view.\n\n<b>Note</b>: If you're using a laptop and touchpad, the way you right-click will vary."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
